{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the app",
  "windows": [
    "main",
    "alert"
  ],
  "webviews": [
    "main",
    "alert"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:event:default",
    "dialog:default",
    "notification:default",
    "autostart:default",
    "process:default",
    "shell:allow-open"
  ]
}